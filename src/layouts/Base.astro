---
/**
 * Basislayout: complete <head>-set (structuurplan §3.8, website-standards huisregel 3),
 * header met altijd zichtbaar hoofdmenu, footer met wettelijke gegevens, skip-link, CSP-meta.
 */
import "../styles/global.css";
import { site, ids } from "../data/site";
import Logo from "../components/Logo.astro";

interface Props {
  titel: string;             // volledige <title>, sitenaam één keer aan het eind
  omschrijving: string;
  ogType?: "website" | "article";
  ogImage?: string;          // absoluut of pad
  noindex?: boolean;
  jsonld?: object | object[]; // extra JSON-LD naast de basis
  breadcrumbs?: { naam: string; url?: string }[];
  bodyClass?: string;
}
const { titel, omschrijving, ogType = "website", ogImage, noindex = false, jsonld, breadcrumbs, bodyClass = "" } = Astro.props;
// PREVIEW=1 (testomgeving): elke pagina noindex — vóór livegang uitzetten (structuurplan hfst. 8, stap c).
const preview = import.meta.env.PREVIEW === "1";

const pad = Astro.url.pathname; // altijd met slash (trailingSlash: always)
const canonical = `${site.origin}${pad}`;
const og = (ogImage ?? site.ogImage).startsWith("http") ? (ogImage ?? site.ogImage) : `${site.origin}${ogImage ?? site.ogImage}`;
const jaar = new Date().getFullYear();

const menu = [
  { naam: "Home", url: "/" },
  { naam: "Portfolio", url: "/portfolio/" },
  { naam: "Over", url: "/over/" },
  { naam: "Contact", url: "/contact/" },
];
const actief = (url: string) => (url === "/" ? pad === "/" : pad.startsWith(url));

// Basis-JSON-LD: Person-node één keer gedefinieerd (op Home), elders via @id gerefereerd.
const persoon = {
  "@type": "Person",
  "@id": ids.persoon,
  name: site.eigenaar,
  url: `${site.origin}/over/`,
  jobTitle: site.functie,
  worksFor: { "@id": ids.organisatie },
  address: { "@type": "PostalAddress", addressLocality: site.plaats, addressCountry: site.land },
  sameAs: [site.linkedin],
};
const organisatie = {
  "@type": "Organization",
  "@id": ids.organisatie,
  name: site.naam,
  url: `${site.origin}/`,
  founder: { "@id": ids.persoon },
  address: { "@type": "PostalAddress", streetAddress: "Kanaalpark 157", postalCode: "2321 JW", addressLocality: site.plaats, addressCountry: site.land },
};
const crumbs = breadcrumbs
  ? {
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbs.map((b, i) => ({ "@type": "ListItem", position: i + 1, name: b.naam, ...(b.url ? { item: `${site.origin}${b.url}` } : {}) })),
    }
  : null;
const graph = [
  ...(pad === "/" ? [{ "@type": "WebSite", "@id": ids.website, url: `${site.origin}/`, name: site.naam, inLanguage: "nl", publisher: { "@id": ids.organisatie } }, organisatie, persoon] : []),
  ...(crumbs ? [crumbs] : []),
  ...(jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : []),
];
const ld = JSON.stringify({ "@context": "https://schema.org", "@graph": graph });

// CSP als meta (GitHub Pages kan geen headers sturen). Alleen Paulines eigen Cloudflare-hosts.
const workerHost = site.formulierEndpoint ? new URL(site.formulierEndpoint).origin : "";
const csp = [
  "default-src 'self'",
  "img-src 'self' data:",
  "font-src 'self'",
  `script-src 'self' https://static.cloudflareinsights.com https://challenges.cloudflare.com`,
  `connect-src 'self' https://cloudflareinsights.com${workerHost ? " " + workerHost : ""}`,
  "frame-src https://challenges.cloudflare.com",
  `form-action 'self'${workerHost ? " " + workerHost : ""}`,
  "object-src 'none'",
  "base-uri 'none'",
  "upgrade-insecure-requests",
].join("; ");
---
<!doctype html>
<html lang="nl" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titel}</title>
    <meta name="description" content={omschrijving} />
    <link rel="canonical" href={canonical} />
    {(noindex || preview) && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={omschrijving} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.naam} />
    <meta property="og:locale" content="nl_NL" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fcfcfc" />

    <link rel="preload" href="/fonts/barlow-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <script type="application/ld+json" set:html={ld} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#inhoud">Direct naar de inhoud</a>

    <header class="site-header" id="site-header">
      <div class="container">
        <a href="/" class="logo" aria-label="strategyC — naar de homepage"><Logo /></a>
        <button class="menuknop" type="button" aria-expanded="false" aria-controls="hoofdmenu" data-menuknop>
          <span data-label>Menu</span>
        </button>
        <nav aria-label="Hoofdmenu">
          <ul class="hoofdmenu" id="hoofdmenu">
            {menu.map((m) => (
              <li><a href={m.url} aria-current={actief(m.url) ? "page" : undefined}>{m.naam}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="inhoud">
      <slot />
    </main>

    {/* Footer: logo + tagline, drie uitgelijnde kolommen (adres, contact, meer), onderregel met wettelijke gegevens.
        Telefoon en btw-id verschijnen alleen als ze in src/data/site.ts zijn ingevuld (geen markering in de footer; Piet 25-08). */}
    <footer class="site-footer">
      <div class="container">
        <div class="footer-boven">
          <a href="/" class="logo" aria-label="strategyC — naar de homepage"><Logo /></a>
          <p class="footer-tagline">Strategisch en creatief advies voor coalities</p>
        </div>
        <div class="footer-kolommen">
          <div>
            <p class="footer-kop">Adres</p>
            <address>{site.adres.split(", ").map((r, i, a) => <>{r}{i < a.length - 1 && <br />}</>)}</address>
          </div>
          <div>
            <p class="footer-kop">Contact</p>
            <ul>
              <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
              {site.telefoon && <li><a href={`tel:${site.telefoon.replace(/\s|\(0\)/g, "")}`}>{site.telefoon}</a></li>}
              <li><a href={site.linkedin} rel="me">LinkedIn</a></li>
            </ul>
          </div>
          <div>
            <p class="footer-kop">Meer</p>
            <ul>
              <li><a href="/boek/">Boek</a></li>
              <li><a href="/privacyverklaring/">Privacyverklaring</a></li>
              <li><a href="/algemene-voorwaarden/">Algemene voorwaarden</a></li>
              <li><a href="/blog/">Blog</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-onder">
          <p>© {jaar} strategyC · {site.eigenaar}</p>
          <p>KVK {site.kvk}{site.btw && <> · btw-id {site.btw}</>}</p>
        </div>
      </div>
    </footer>

    <script is:inline src="/js/menu.js" defer></script>
    {site.analyticsToken && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${site.analyticsToken}"}`}></script>
    )}
  </body>
</html>

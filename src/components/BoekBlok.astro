---
/** Boekverwijzing (v9 §1.6 op Home, §3 Boekblok op Over). Linkt naar de eigen boekpagina /boek/. */
import { site } from "../data/site";
interface Props { variant?: "home" | "over"; }
const { variant = "home" } = Astro.props;
---
<div class="boek">
  <a class="cover" href={site.boekLink} tabindex="-1" aria-hidden="true">
    <img src={site.boekCover} alt="" width="300" height="300" loading="lazy" decoding="async" />
  </a>
  <div class="prose">
    <span class="kop-label">Boek</span>
    <h2>{site.boekTitel}{variant === "over" && <span class="secundair"> ({site.boekJaar})</span>}</h2>
    {variant === "home"
      ? <p>In mijn boek beschrijf ik in tien concrete stappen hoe verandering werkt als je de mens centraal stelt, gebaseerd op wetenschap en 25 jaar praktijk.</p>
      : <p>Verandering slaagt als je de mens centraal stelt. In dit boek beschrijf ik tien stappen voor mensgerichte transformatie, gebaseerd op wetenschappelijke inzichten en 25 jaar praktijkervaring.</p>}
    <a class="pijl-link" href={variant === "home" ? site.boekLink : `${site.boekLink}#bestellen`}>{variant === "home" ? "Meer over het boek →" : "Bestel het boek →"}</a>
  </div>
</div>

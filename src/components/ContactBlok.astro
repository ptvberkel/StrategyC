---
/**
 * Contactblok (webteksten v9 §1.7) — onderaan Home. Variant `kort` onder portfolio en cases.
 */
import { site } from "../data/site";
interface Props { kort?: boolean; }
const { kort = false } = Astro.props;
const tel = site.telefoon.replace(/\s|\(0\)/g, "");
---
<section class="sectie sectie--grijs" aria-labelledby="contact-kop">
  <div class="container">
    {kort ? (
      <div class="twee">
        <div>
          <h2 id="contact-kop">Benieuwd of ik iets voor jouw samenwerking kan betekenen?</h2>
        </div>
        <div class="knoppen"><a class="knop" href="/contact/">Plan een oriënterend gesprek</a></div>
      </div>
    ) : (
      <div class="prose">
        <h2 id="contact-kop">Herken je een van deze situaties?</h2>
        <p>In een halfuur hoor ik waar jullie staan en vertel ik hoe ik het zou aanpakken. Ben ik niet de juiste persoon, dan zeg ik dat ook.</p>
        <div class="knoppen"><a class="knop" href="/contact/">Plan een oriënterend gesprek</a></div>
        {site.telefoon && <p>Of bel direct: <a href={`tel:${tel}`}>{site.telefoon}</a></p>}
      </div>
    )}
  </div>
</section>

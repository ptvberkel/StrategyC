---
/**
 * Boekpagina /boek/ (nieuw, 14-10). Vervangt de oude portfoliopagina
 * /portfolio/handboek-succesvol-mensgericht-transformeren/ (redirect in redirects.ts).
 * Recensies: src/data/recensies.json (ook bewerkbaar in Pages CMS). Lege tekst = gele markering.
 */
import Base from "../layouts/Base.astro";
import CTeken from "../components/CTeken.astro";
import Placeholder from "../components/Placeholder.astro";
import ContactBlok from "../components/ContactBlok.astro";
import { site, ids } from "../data/site";
import data from "../data/recensies.json";

type Recensie = { naam: string; functie: string; kop: string; tekst: string; organisatie?: boolean; uitgelicht?: boolean };
const alle = data.recensies as Recensie[];
const groot = alle.find((r) => r.uitgelicht);
const overige = alle.filter((r) => r !== groot);
const metTekst = alle.filter((r) => r.kop.trim());
const body = (r: Recensie) => [r.kop, r.tekst].filter(Boolean).join(" ");
const afzender = (r: Recensie) => r.naam || r.functie;

const boek = {
  "@type": "Book",
  "@id": `${site.origin}/boek/#boek`,
  name: site.boekTitel,
  isbn: "9789493277304",
  datePublished: site.boekJaar,
  inLanguage: "nl",
  image: `${site.origin}${site.boekCover}`,
  author: { "@type": "Person", "@id": ids.persoon, name: site.eigenaar },
  ...(metTekst.length
    ? {
        review: metTekst.map((r) => ({
          "@type": "Review",
          reviewBody: body(r),
          author: r.organisatie || !r.naam
            ? { "@type": "Organization", name: r.naam || r.functie }
            : { "@type": "Person", name: r.naam, jobTitle: r.functie },
        })),
      }
    : {}),
};
---
<Base
  titel="In 10 stappen succesvol transformeren | Boek van Pauline Kamphuis"
  omschrijving="Het boek over mensgerichte transformatie van Pauline Kamphuis: tien stappen, gebaseerd op wetenschap en 25 jaar praktijk. Lees wat lezers zeggen, koop of leen het boek."
  jsonld={boek}
  breadcrumbs={[{ naam: "Home", url: "/" }, { naam: "Boek" }]}
>
  <section class="sectie" aria-labelledby="boek-kop">
    <div class="container boek-kop">
      <div class="cover-groot">
        <img src={site.boekCover} alt="Cover van het boek In 10 stappen succesvol transformeren van Pauline Kamphuis" width="300" height="300" fetchpriority="high" decoding="async" />
      </div>
      <div class="prose">
        <h1 id="boek-kop">{site.boekTitel}</h1>
        <p class="boek-meta">{site.eigenaar} · {site.boekJaar}</p>
        <p class="intro">Verandering slaagt als je de mens centraal stelt. In dit boek beschrijf ik tien stappen voor mensgerichte transformatie, gebaseerd op wetenschappelijke inzichten en 25 jaar praktijkervaring.</p>
        <p><Placeholder regel>PAULINE: optioneel 2–3 zinnen extra: voor wie is het boek, wat vind je erin (modellen, checklists, voorbeelden)?</Placeholder></p>
        <div class="knoppen">
          <a class="knop" href="#bestellen">Bestel of leen het boek</a>
          <a class="knop knop--secundair" href="#recensies">Wat lezers zeggen</a>
        </div>
      </div>
    </div>
  </section>

  <section class="sectie sectie--grijs" aria-labelledby="bestellen-kop" id="bestellen">
    <div class="container">
      <h2 class="kop-c" id="bestellen-kop"><CTeken rood /> Bestellen of lenen</h2>
      <div class="bestel">
        {site.boekKopen.map((k, i) => (
          <a class={`bestel-kaart${i === 0 ? " bestel-kaart--hoofd" : ""}`} href={k.url} rel="noopener">
            <strong>{k.label}</strong>
            <span class="klein secundair">{k.toelichting}</span>
            <span class="pijl" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sectie" aria-labelledby="recensies-kop" id="recensies">
    <div class="container">
      <h2 class="kop-c" id="recensies-kop"><CTeken /> Wat lezers zeggen</h2>
      {groot && (
        <figure class="quote-groot">
          <blockquote><p>{groot.kop}</p>{groot.tekst && <p class="vervolg">{groot.tekst}</p>}</blockquote>
          <figcaption>{groot.naam && <strong>{groot.naam}</strong>}<span class={groot.naam ? "secundair" : ""}>{groot.functie}</span></figcaption>
        </figure>
      )}
      <div class="recensies">
        {overige.map((r) => (
          <figure class="recensie">
            <blockquote>
              <p class="recensie-kop">{r.kop}</p>
              {r.tekst && <p>{r.tekst}</p>}
            </blockquote>
            <figcaption>{r.naam && <strong>{r.naam}</strong>}<span class={r.naam ? "secundair" : ""}>{r.functie}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <ContactBlok kort />
</Base>

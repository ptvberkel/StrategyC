---
/** Blogartikel — byline met datum, BlogPosting met author → Person. */
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { site, ids } from "../../data/site";
export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
const datum = (iso: string) => new Date(iso).toLocaleDateString("nl-NL", { day: "numeric", month: "long", year: "numeric" });
const posting = { "@type": "BlogPosting", headline: p.data.titel, datePublished: p.data.datum, ...(p.data.bijgewerkt ? { dateModified: p.data.bijgewerkt } : {}), author: { "@type": "Person", "@id": ids.persoon, name: site.eigenaar, url: `${site.origin}/over/` }, mainEntityOfPage: `${site.origin}/blog/${p.id}/`, inLanguage: "nl" };
---
<Base titel={`${p.data.titel} — strategyC`} omschrijving={p.data.metaOmschrijving ?? p.data.titel} ogType="article" jsonld={posting} breadcrumbs={[{ naam: "Home", url: "/" }, { naam: "Blog", url: "/blog/" }, { naam: p.data.titel }]}>
  <article class="sectie"><div class="container prose">
    <a class="pijl-link klein" href="/blog/">← Alle artikelen</a>
    <h1>{p.data.titel}</h1>
    <p class="secundair klein">Door <a href="/over/">{site.eigenaar}</a> · <time datetime={p.data.datum}>{datum(p.data.datum)}</time></p>
    <Content />
  </div></article>
</Base>

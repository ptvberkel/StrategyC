---
/** Home — zeven blokken in vaste volgorde (19-10, akkoord Pauline): opening · klanten · publiek-privaat · bellen · cases · boek · contact. Teksten: webteksten v10. */
import Base from "../layouts/Base.astro";
import CTeken from "../components/CTeken.astro";
import CaseCard from "../components/CaseCard.astro";
import ContactBlok from "../components/ContactBlok.astro";
import BoekBlok from "../components/BoekBlok.astro";
import { getCollection } from "astro:content";
import { C_LABELS, VAST } from "../data/cs";
import { site } from "../data/site";

const alle = (await getCollection("cases")).sort((a, b) => a.data.volgorde - b.data.volgorde);
const uitgelicht = alle.filter((c) => c.data.uitgelicht).slice(0, 4); // keuze Pauline 19-10: energietransitie, HSD-jubileum, Living Lab
const bySlug = Object.fromEntries(alle.map((c) => [c.id, c]));
const caseUrl = (slug?: string) => (slug && bySlug[slug] ? `/portfolio/${slug}/` : undefined);

// v10 — vier momenten. Voorbeelden staan los eronder, niet gekoppeld aan een moment (wens Pauline).
const momenten: { kop: string; tekst: string }[] = [
  {
    kop: "Jullie coalitie gaat van start",
    tekst: "Er zijn initiatiefnemers en een ambitie, maar nog geen verhaal dat alle partners kunnen vertellen. Na gesprekken met de initiatiefnemers leid ik een workshop waarin wij samen de kern bepalen. Daarna schrijf ik het narratief, in verschillende lengtes. Voor de lancering maak ik een persbericht en teksten die partners op hun eigen kanalen plaatsen, zodat het verhaal onder ieders logo hetzelfde klinkt. Zo nodig ontwerp ik een eenvoudige beeldstijl of logo.",
  },
  {
    kop: "Jullie initiatief heeft een naam nodig",
    tekst: "Een werknaam beschrijft vaak het probleem, of blijkt al door een ander gebruikt te worden. Samen stellen we criteria op. Ik werk kandidaten uit en doe verkennend onderzoek naar merkregistraties en beschikbare domeinnamen. De stuurgroep krijgt een onderbouwde shortlist om over te besluiten, met een naam die van alle partners is.",
  },
  {
    kop: "Jullie willen laten zien wat de samenwerking oplevert",
    tekst: "Een project loopt af of er komt een jubileum aan. Ik interview de betrokkenen en maak er een whitepaper, magazine of jubileumboek van, inclusief de vormgeving. Een jubileum vier je niet eenmalig. Ik maak een jaarprogramma met media- en podiummomenten en uitingen waarin partners en stakeholders aan het woord komen.",
  },
  {
    kop: "De samenwerking krijgt een fysieke plek",
    tekst: "Een campus of een gedeeld kantoor. Ik denk mee over wat de plek moet uitstralen en waar mensen elkaar tegenkomen. Ik vertaal de beoogde identiteit van de samenwerking naar wat daarvoor nodig is in het (interieur)ontwerp, en help bij de marktintroductie en de opening.",
  },
];

// v10 — voorbeelden. Een onderdeel linkt alleen als de casepagina bestaat (HSD Campus: case volgt).
type Deel = { tekst: string; slug?: string };
const voorbeelden: Deel[][] = [
  [{ tekst: "Innovatiecoalitie Cyberveilige Energietransitie: elf initiatiefnemers, één verhaal en herkenbare naam", slug: "cyberveilige-energietransitie" }],
  [{ tekst: "HSD Campus, van advies over interieurontwerp en branding in het gebouw tot marktintroductie en openingsceremonie" }],
  [
    { tekst: "Whitepaper over vijf jaar Living Lab Scheveningen (gemeente Den Haag)", slug: "living-lab-scheveningen" },
    { tekst: "jubileummagazine tien jaar ICSSS met ruim dertig partners", slug: "cyber-security-summer-school" },
    { tekst: "jubileumjaar en -boek tien jaar Security Delta (HSD)", slug: "security-delta" },
  ],
];

// v10 — klantvermelding. Eigen case → casepagina; anders de site van de klant (wens Pauline, ook voor vindbaarheid).
const klanten: { naam: string; slug?: string; url?: string }[] = [
  { naam: "Security Delta (HSD)", slug: "security-delta" },
  { naam: "HSD Campus", url: "https://hsdcampus.nl/" },
  { naam: "InnovationQuarter", url: "https://www.innovationquarter.nl/" },
  { naam: "HCSS", url: "https://hcss.nl/" },
  { naam: "Innovatiecoalitie Cyberveilige Energietransitie", slug: "cyberveilige-energietransitie" },
  { naam: "Living Lab Scheveningen", slug: "living-lab-scheveningen" },
  { naam: "Impactcoalitie Smart Secure Cities", url: "https://veiligesmartcities.nl/" },
];
const klantHref = (k: (typeof klanten)[number]) => caseUrl(k.slug) ?? k.url;
---
<Base
  titel="strategyC | Strategie en creatie voor coalities"
  omschrijving="Strategisch en creatief advies voor publiek-private samenwerking: naam en narratief bij de start, scenario's voor besluiten, whitepapers en jubileumuitgaven."
  bodyClass="hero-donker"
>
  <!-- 1 Opening — met de zes C's als vallende cirkels over de volle breedte -->
  <section class="hero hero--cirkels" aria-labelledby="hero-kop">
    <div class="container hero-kop">
      <h1 id="hero-kop">Strategie en creatie voor coalities</h1>
    </div>
    <div class="container hero-tekst">
      <p class="intro">Werk je in een publiek-private samenwerking aan een maatschappelijke opgave? Ik schrijf het verhaal waar alle partners achter staan en ontwikkel wat nodig is om het uit te dragen: naam, narratief, lancering, whitepaper, magazine, visualisaties of scenario's voor besluitvorming.</p>
      <div class="knoppen">
        <a class="knop" href="/contact/">Plan een oriënterend gesprek</a>
        <a class="knop knop--secundair" href="/portfolio/">Bekijk voorbeelden</a>
      </div>
    </div>
    <nav class="cirkels" id="cirkels" data-labels={C_LABELS.join("|")} data-vast={VAST} aria-label="De zes C's — klik voor het bijbehorende werk">
      <ul class="sr-only">{C_LABELS.map((c) => <li><a href={c === VAST ? "/portfolio/" : `/portfolio/?c=${c.toLowerCase()}`}>{c}</a></li>)}</ul>
    </nav>
  </section>

  <!-- 2 Ik werk(te) onder meer voor — klantvermelding in tekst, geen logo's -->
  <section class="sectie" aria-labelledby="klanten-kop">
    <div class="container">
      <h2 class="kop-c" id="klanten-kop"><CTeken /> Ik werk(te) onder meer voor</h2>
      <p class="klanten">
        {klanten.map((k, i) => (
          <>
            {klantHref(k) ? <a href={klantHref(k)} rel={k.url && !k.slug ? "noopener" : undefined}>{k.naam}</a> : k.naam}
            {i < klanten.length - 1 ? <span>, </span> : <span>.</span>}
          </>
        ))}
      </p>
    </div>
  </section>

  <!-- 3 Publiek-privaat werkt anders (met foto) -->
  <section class="sectie sectie--grijs" aria-labelledby="pps-kop">
    <div class="container persoon">
      <div class="portret">
        <img src={site.portret} alt="Pauline Kamphuis, oprichter van strategyC" width="800" height="800" loading="lazy" decoding="async" />
      </div>
      <div class="prose">
        <h2 id="pps-kop">Publiek-privaat werkt anders</h2>
        <p>In een publiek-private samenwerking legt elke partner verantwoording af aan een eigen achterban: een wethouder aan de gemeenteraad, een directeur aan de aandeelhouders. Besluiten volgen verschillende ritmes, en het gezamenlijke verhaal moet werken onder ieders logo. De communicatie ligt meestal bij een klein programmabureau zonder groot budget.</p>
        <p>Ik ken beide kanten. Ik was communicatiedirecteur bij internationale ingenieursbureaus. Met mijn vorige bureau, Alignment Factory, maakte ik de communicatiestrategie voor het net opgerichte InnovationQuarter en voor HCSS, en verzorgde ik voor de gemeente Den Haag de marktintroductie en de openingsceremonie van de HSD Campus. Security Delta (HSD) adviseer ik sinds de voorbereidingen van de oprichting in 2012.</p>
        <a class="pijl-link" href="/over/">Meer over mij →</a>
      </div>
    </div>
  </section>

  <!-- 4 Hiervoor kun je me bellen — vier momenten, voorbeelden los eronder -->
  <section class="sectie" aria-labelledby="bellen-kop">
    <div class="container">
      <div class="prose">
        <h2 class="kop-c" id="bellen-kop"><CTeken /> Hiervoor kun je me bellen</h2>
        <p class="intro">Coalities en publiek-private samenwerkingen schakelen me meestal in op een van deze momenten.</p>
      </div>
      <ul class="aanleidingen" role="list">
        {momenten.map((m) => (
          <li class="aanleiding">
            <h3>{m.kop}</h3>
            <p>{m.tekst}</p>
          </li>
        ))}
      </ul>
      <div class="voorbeelden">
        <h3 class="kop-label">Voorbeelden</h3>
        <ul role="list">
          {voorbeelden.map((regel) => (
            <li>
              {regel.map((v, j) => (
                <>
                  {caseUrl(v.slug) ? <a href={caseUrl(v.slug)}>{v.tekst}</a> : <span>{v.tekst}</span>}
                  {j < regel.length - 1 && <span class="secundair"> · </span>}
                </>
              ))}
            </li>
          ))}
        </ul>
      </div>
      <div class="aanleidingen-cta">
        <p>Herken je jouw situatie?</p>
        <a class="knop" href="/contact/">Plan een oriënterend gesprek</a>
      </div>
    </div>
  </section>

  <!-- 5 Van ambitie naar beweging — uitgelichte cases -->
  <section class="sectie sectie--grijs" aria-labelledby="werk-kop">
    <div class="container">
      <div class="twee">
        <div class="prose">
          <h2 id="werk-kop">Van ambitie naar beweging</h2>
          <p>Ik help coalities scherp krijgen waar ze samen voor staan en waar het mis zou kunnen gaan. Dat doe ik in gesprekken en workshops, met de partijen zelf aan tafel. Het resultaat is tastbaar: een verbindend narratief, een boek, artist impressions of een gedragen besluit. Hieronder een greep uit eerder werk.</p>
        </div>
        <div class="knoppen"><a class="knop knop--secundair" href="/portfolio/">Naar het portfolio</a></div>
      </div>
      <div class="raster">
        {uitgelicht.map((c, i) => <CaseCard c={c} lazy={i > 0} />)}
      </div>
    </div>
  </section>

  <!-- 6 Boek -->
  <section class="sectie" aria-label="Boek">
    <div class="container"><BoekBlok variant="home" /></div>
  </section>

  <!-- 7 Contact -->
  <ContactBlok />

  <script is:inline src="/js/cirkels.js" defer></script>
</Base>
